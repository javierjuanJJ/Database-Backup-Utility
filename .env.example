# ------------------------------------------------------------------
# Database Backup Utility - Variables de entorno opcionales
# Copie este archivo a .env y complete los valores que necesite.
# ------------------------------------------------------------------

# --------------------------------------------
# Almacenamiento local
# --------------------------------------------
BACKUP_OUT_DIR=./backups
BACKUP_LOG_DIR=./logs

# --------------------------------------------
# AWS S3
# --------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=db-backups/

# --------------------------------------------
# Google Cloud Storage
# --------------------------------------------
# Alternativa A: ruta al archivo JSON de service account
GCS_KEY_FILE=
# Alternativa B: variable de entorno estándar de Google (GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=
GCS_PREFIX=db-backups/

# --------------------------------------------
# Azure Blob Storage
# --------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER=
AZURE_PREFIX=db-backups/

# --------------------------------------------
# Notificaciones (Slack)
# --------------------------------------------
SLACK_WEBHOOK_URL=

# --------------------------------------------
# Credenciales de bases de datos (alternativa a flags CLI)
# --------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=